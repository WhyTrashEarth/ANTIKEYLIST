---
import Layout from '../layouts/Layout.astro';
import { ALPHABET, GROUPS } from '../lib/alphabet.mjs';
const repo = 'https://github.com/WhyTrashEarth/ANTIKEYLIST';
const samples = [
  { value: '0Oo', label: '0 O o', note: 'Zero and the letter O: all three are left out of the original set.' },
  { value: '1lI', label: '1 l I', note: 'One, lowercase L, uppercase I: all three are left out of the original set.' },
  { value: '5Ss', label: '5 S s', note: 'Five and the letter S: all three are left out of the original set.' },
  { value: 'Cc', label: 'C c', note: 'Both C and c are in the original set. Their similarity is one of its tradeoffs.' },
  { value: '9g', label: '9 g', note: 'Both 9 and g are in the original set. The font can make a big difference here.' },
];
const code = `import secrets\n\nalphabet = (\n    "3479ACDEFGHJKMNPQRTUVWXY"\n    "acdefghjkmnpqrtuvwy@#$%^&*_+="\n)\n\ncode = "".join(\n    secrets.choice(alphabet)\n    for _ in range(12)\n)`;
---
<Layout>
  <header class="site-header shell">
    <a class="wordmark" href="#" aria-label="Anti Key List home"><span class="brand-key" aria-hidden="true">A<span>♥</span></span><span>ANTI<br />KEY LIST<span class="brand-period">.</span></span></a>
    <nav aria-label="Main navigation">
      <a href="#idea">The idea</a><a href="#playground">Playground</a><a href="#character-set">The list</a>
    </nav>
    <a class="button button-small button-outline nav-github" href={repo}>Find us on GitHub <span aria-hidden="true">↗</span></a>
  </header>

  <main id="main">
    <section class="hero shell" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> SMALL CHARACTERS. HUMAN DESIGN.</p>
        <h1 id="hero-heading">A little less<br /><span class="pink-underline">guesswork.</span></h1>
        <p class="hero-description">Is that an O or a 0? An I or an l?<br />Let’s make the codes we read and type a little kinder to the people using them.</p>
        <div class="hero-actions"><a class="button button-dark" href="#playground">Find your clarity <span aria-hidden="true">↘</span></a><a class="text-link" href="#character-set">Meet the character set <span aria-hidden="true">→</span></a></div>
        <p class="hero-footnote">An open-source idea. A big love of legibility.</p>
      </div>
      <div class="hero-art">
        <div class="annie-backdrop" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span></div>
        <div class="hello-note">Oh, hi!<br />I’m Annie Key.<svg viewBox="0 0 59 46" aria-hidden="true"><path d="M5 4c34-3 45 17 35 35m-8-11 8 12 13-7" /></svg></div>
        <img class="annie" src="/art/annie-key-original.png" alt="Annie Key, a cheerful blonde character with pink heart-shaped glasses and stars in her eyes." width="588" height="549" fetchpriority="high" />
        <span class="floating-key floating-key-a" aria-hidden="true">A</span><span class="floating-key floating-key-7" aria-hidden="true">7</span>
        <div class="clarity-seal" aria-hidden="true">♥<span>HERE FOR<br />THE HUMANS</span></div>
        <a class="art-credit" href="https://vgen.co/Mainlian">Annie artwork by Nano <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <div class="ribbon-frame" aria-hidden="true"><div class="ribbon"><div>LESS SQUINTING <span>✳</span> MORE CLARITY <span>✳</span> A LITTLE HUMAN KINDNESS <span>✳</span> LESS SQUINTING <span>✳</span> MORE CLARITY <span>✳</span></div></div></div>

    <section class="idea section shell" id="idea" aria-labelledby="idea-heading">
      <div class="section-intro"><p class="eyebrow">01 / THE IDEA</p><h2 id="idea-heading">Tiny characters.<br />Real frustration.</h2><p>A product key. A reference code. That one character you’ve typed three different ways.</p><p>Anti Key List is a proposed alphabet for short codes. It leaves out some familiar look-alikes—like <strong>O, 0, I, l and 1</strong>—before the guesswork starts.</p><a class="text-link" href="#character-set">See what made the list <span aria-hidden="true">↘</span></a></div>
      <div class="idea-visual">
        <p class="eyebrow">WE’VE ALL BEEN HERE.</p>
        <div class="confusion-row" aria-label="Zero, uppercase O, lowercase o"><span>0</span><span>O</span><span>o</span></div>
        <div class="idea-annotation"><span class="hand-arrow" aria-hidden="true">↖</span> Three characters.<br />One unnecessary guessing game.</div>
        <p class="idea-caption">A different alphabet is a starting point.<br />The font, size and context still matter.</p>
      </div>
    </section>

    <section class="playground section" id="playground" aria-labelledby="playground-heading">
      <div class="shell">
        <div class="section-heading"><div><p class="eyebrow">02 / THE CLARITY PLAYGROUND</p><h2 id="playground-heading">Give your eyes<br />something to play with.</h2></div><p>Compare a few troublesome characters.<br />Make a code. Check a sample.<br /><span class="local-note"><span aria-hidden="true">◎</span> Everything happens in your browser.</span></p></div>
        <noscript><p class="noscript-note">The interactive playground needs JavaScript. The complete character set, explanations and source links below work without it.</p></noscript>
        <div class="workshop" data-workshop>
          <div class="tab-list" role="tablist" aria-label="Playground tools">
            <button id="tab-compare" role="tab" aria-selected="true" aria-controls="panel-compare" tabindex="0"><span aria-hidden="true">Aa</span> Compare characters</button>
            <button id="tab-generate" role="tab" aria-selected="false" aria-controls="panel-generate" tabindex="-1"><span aria-hidden="true">✳</span> Make a code</button>
            <button id="tab-check" role="tab" aria-selected="false" aria-controls="panel-check" tabindex="-1"><span aria-hidden="true">✓</span> Check a code</button>
          </div>
          <div id="panel-compare" role="tabpanel" aria-labelledby="tab-compare" tabindex="0" class="tool-panel">
            <div class="tool-controls">
              <h3>Same characters.<br /> Different story.</h3><p>Switch the font and see what your eyes notice.</p>
              <fieldset class="sample-picker"><legend>Pick a group</legend><div>{samples.map((sample, i) => <button type="button" class="sample-button" aria-pressed={i === 0 ? 'true' : 'false'} data-characters={sample.value} data-note={sample.note} aria-label={`Compare ${sample.label}`}>{sample.label}</button>)}</div></fieldset>
              <label class="field-label" for="font-select">Typeface</label><select id="font-select"><option value="atkinson">Atkinson Hyperlegible</option><option value="sans">Arial / system sans</option><option value="serif">Georgia / system serif</option><option value="mono">System monospace</option></select>
              <div class="range-label"><label for="type-size">Character size</label><output id="size-output" for="type-size">88 px</output></div><input id="type-size" type="range" min="32" max="104" value="88" step="4" />
            </div>
            <div class="comparison-stage">
              <p class="specimen-label">A CLOSER LOOK</p>
              <div id="specimen" class="specimen" aria-label="Zero, uppercase O, lowercase o">{['0','O','o'].map(char=><div class="specimen-character"><span class="specimen-glyph">{char}</span><span class="membership">Left out</span></div>)}</div>
              <p id="comparison-note" class="comparison-note" aria-live="polite">{samples[0].note}</p>
              <span class="specimen-bottom">THE FONT IS PART OF THE CONVERSATION.</span>
            </div>
          </div>
          <div id="panel-generate" role="tabpanel" aria-labelledby="tab-generate" tabindex="0" class="tool-panel" hidden>
            <div class="tool-controls"><h3>A code from<br /> the original set.</h3><p>Every character comes from the same {ALPHABET.length}-character alphabet below.</p><label class="field-label" for="code-length">Number of characters</label><select id="code-length"><option value="8">8 characters</option><option value="12" selected>12 characters</option><option value="16">16 characters</option><option value="24">24 characters</option></select><button class="button button-dark" id="generate-code" type="button">Make another code <span aria-hidden="true">↻</span></button><p class="tool-hint">Uses your browser’s cryptographic random source. Codes aren’t sent anywhere.</p></div>
            <div class="code-stage"><p class="specimen-label" id="generation-label">EXAMPLE CODE</p><output id="generated-code" class="generated-code" aria-live="polite">AH7m@9Q+Yk4=</output><button class="button button-outline" id="copy-code" type="button">Copy code <span aria-hidden="true">↗</span></button><p class="copy-status" id="code-copy-status" role="status"></p><p class="comparison-note">Legibility is one design choice. A secure system also needs appropriate code length, storage and limits on guessing.</p></div>
          </div>
          <div id="panel-check" role="tabpanel" aria-labelledby="tab-check" tabindex="0" class="tool-panel" hidden>
            <div class="tool-controls"><h3>Does it make<br /> the list?</h3><p>Check whether a sample uses only the original alphabet. We’ll flag characters, never silently change them.</p><button class="text-link" id="try-sample" type="button">Try a tricky example <span aria-hidden="true">→</span></button><p class="tool-hint">Use a sample, not a real password or private access code. Spaces and line breaks count, too.</p></div>
            <div class="check-stage"><label class="field-label" for="check-input">Your sample</label><textarea id="check-input" rows="3" maxlength="2000" placeholder="Type or paste a sample…" spellcheck="false" autocomplete="off" autocapitalize="off" aria-describedby="check-help"></textarea><p id="check-help" class="input-help">Up to 2,000 characters. Case is preserved.</p><div id="check-result" class="check-result" role="status" aria-live="polite"><strong>A little clarity starts here.</strong><p>Enter a sample to see which characters belong to the set.</p></div><button id="clear-sample" class="text-link" type="button">Clear sample</button></div>
          </div>
        </div>
        <p class="playground-footnote">An experiment in legibility, not a universal accessibility standard. Try it with the people and typefaces you’re designing for.</p>
      </div>
    </section>

    <section class="alphabet-section section shell" id="character-set" aria-labelledby="alphabet-heading">
      <div class="section-heading"><div><p class="eyebrow">03 / MEET THE ORIGINAL ALPHABET</p><h2 id="alphabet-heading">A smaller set.<br />A thoughtful start.</h2></div><div class="alphabet-intro"><p><strong>{ALPHABET.length} characters.</strong> Numbers, letters and symbols, kept exactly as proposed in the original repository.</p><button class="button button-outline" id="copy-alphabet" type="button">Copy the full character set <span aria-hidden="true">↗</span></button><span class="copy-status" id="alphabet-copy-status" role="status"></span></div></div>
      <div class="alphabet-groups">{GROUPS.map((group,i)=><div class={`alphabet-group alphabet-group-${i}`}><div class="group-heading"><h3>{group.label}</h3><span>{group.characters.length} characters</span></div><div class="keycaps" aria-label={group.label}>{Array.from(group.characters).map(char=><span class="keycap">{char}</span>)}</div></div>)}</div>
      <div class="alphabet-note"><span aria-hidden="true">↳</span><p><strong>A proposal with room to grow.</strong> Pairs like C/c and 9/g remain in the original set. Some symbols can be hard to read aloud or enter on certain keyboards. Choose deliberately for your context.</p><a class="text-link" href={`${repo}/issues`}>Help improve it <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="builder-section section" id="builders" aria-labelledby="builder-heading"><div class="shell builder-grid"><div><p class="eyebrow">04 / MADE TO BE BUILT ON</p><h2 id="builder-heading">Small change.<br />Better starting point.</h2><p>Use a restricted alphabet when you create a reference code or identifier that someone will need to read and retype.</p><p class="builder-caution">Keep names, messages and other human language open. This is an alphabet for generated codes, not a rule for what people can say.</p><a class="button button-pink" href={repo}>Explore the project on GitHub <span aria-hidden="true">↗</span></a></div><div class="code-card"><div class="code-card-heading"><span>PYTHON / A STARTING POINT</span><button id="copy-snippet" type="button" aria-label="Copy Python example">Copy <span aria-hidden="true">↗</span></button></div><pre><code id="python-snippet">{code}</code></pre><p class="copy-status" id="snippet-copy-status" role="status"></p><p class="code-card-note">The complete project includes Python, Java and browser examples. The code and alphabet are dedicated to the public domain under CC0.</p></div></div></section>

    <section class="people-section section shell" aria-labelledby="people-heading"><div class="people-heading"><span class="heart-doodle" aria-hidden="true">♡</span><p class="eyebrow">A LITTLE PROJECT. A LOT OF HEART.</p><h2 id="people-heading">Good ideas are<br />made by people.</h2><p>Annie Key is our little cheerleader for legibility.<br />And these are some of the people behind the idea.</p></div><div class="credits-list"><div><span class="credit-label">THE ARTIST</span><h3><a href="https://vgen.co/Mainlian">Nano <span aria-hidden="true">↗</span></a></h3><p>The artist behind Annie’s bright eyes, blonde hair and heart-shaped glasses. Thank you for bringing her to life.</p></div><div><span class="credit-label">THE INSPIRATION</span><h3><a href="https://www.twitch.tv/aviituber">Aviituber (Avii) <span aria-hidden="true">↗</span></a></h3><p>The original project is dedicated to Avii, whose love of design and accessibility helped inspire the idea.</p></div><div><span class="credit-label">THE TYPEFACE</span><h3><a href="https://www.brailleinstitute.org/freefont/">Braille Institute <span aria-hidden="true">↗</span></a></h3><p>Creators of Atkinson Hyperlegible, the font used throughout this site. Clear letterforms are part of the story.</p></div></div></section>
  </main>

  <footer class="site-footer"><div class="shell"><div class="footer-top"><div><p class="eyebrow">LET’S MAKE THINGS A LITTLE CLEARER.</p><a class="footer-title" href={repo}>Open source.<br />Open to your ideas. <span aria-hidden="true">↗</span></a></div><span class="footer-key" aria-hidden="true">♥</span></div><div class="footer-bottom"><a class="footer-brand" href="#">ANTI KEY LIST.</a><div><a href={repo}>Follow on GitHub ↗</a><a href={`${repo}/issues`}>Questions & ideas ↗</a><a href="/about/">Credits & privacy</a></div><p>Code & alphabet: CC0.<br />Annie Key artwork by <a href="https://vgen.co/Mainlian">Nano</a>.</p></div></div></footer>
  <script>import '../scripts/playground';</script>
</Layout>
